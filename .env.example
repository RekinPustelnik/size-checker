# =============================================================================
# Konfiguracja środowiskowa — Size Checker (.env)
# Skopiuj ten plik do '.env' i uzupełnij własnymi danymi.
# =============================================================================

# 1. Google Cloud Service Account Email (z pobranego pliku JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL="twoj-bot@twoj-projekt.iam.gserviceaccount.com"

# 2. Google Cloud Service Account Private Key (z pobranego pliku JSON)
# Zwróć uwagę na format: klucz wielolinijkowy lub ze znakami \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQ...\n-----END PRIVATE KEY-----\n"

# 3. ID Arkusza Google Sheets (z adresu URL arkusza)
# Format: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID="1a2B3c4D5e6F7g8H9i0J_TUTAJ_ZNAJDUJE_SIE_ID"

# 4. URL Webhooka Discord do wysyłania alertów o rozmiarach
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz"
